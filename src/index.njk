---
layout: base.njk
---
<section class="hero now" aria-labelledby="now">
  <p class="eyebrow" id="now">Now · {{ now.updated | readableMonth }}</p>
  <h1>{{ now.headline | safe }}</h1>
  <p class="lede">{{ now.text }}</p>
  <p class="actions"><a class="button" href="https://skel.run">Visit skel.run</a></p>
</section>

{%- set posts = collections.posts | reverse %}
<section class="section prose-width" aria-labelledby="writing">
  <p class="eyebrow">Writing</p>
  <h2 id="writing">Notes on building software with coding agents</h2>
  {%- if posts.length %}
  {% include "post-list.njk" %}
  {%- else %}
  <p class="muted">No posts yet.</p>
  {%- endif %}
  <p class="more-plain">Subscribe with the <a href="/feed.xml">Atom feed</a>.</p>
</section>

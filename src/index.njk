---
layout: base.njk
---
<section class="hero">
  <h1>{{ offer.headline }}</h1>
  <p class="lede">{{ offer.intro }}</p>
  <p class="lede-2">{{ offer.pitch | safe }}</p>
  <p class="actions">
    <a class="button" href="/work/">Work with me</a>
    <a class="button button-quiet" href="mailto:{{ site.email }}">Email me</a>
  </p>
</section>

{%- set posts = collections.posts | reverse | head(3) %}
{%- if posts.length %}
<section class="section prose-width" aria-labelledby="writing">
  <p class="eyebrow">Writing</p>
  <h2 id="writing">Latest posts</h2>
  {% include "post-list.njk" %}
  <p class="more"><a href="/writing/">All writing</a></p>
</section>
{%- endif %}

{% include "next-step.njk" %}

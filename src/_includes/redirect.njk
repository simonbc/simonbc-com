<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <title>{{ site.title }}</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ site.url }}{{ redirectTo }}">
  <meta http-equiv="refresh" content="0; url={{ redirectTo }}">
</head>
<body>
  <p><a href="{{ redirectTo }}">{{ site.url }}{{ redirectTo }}</a></p>
</body>
</html>

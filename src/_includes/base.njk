<!doctype html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="light dark">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="site-name" href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ site.title }}</a>
    <nav aria-label="Main">
      <ul>
        <li><a href="/#now">Now</a></li>
        <li><a href="/#writing">Writing</a></li>
        <li><a href="/about/"{% if page.url.startsWith("/about/") %} aria-current="page"{% endif %}>About</a></li>
      </ul>
    </nav>
  </header>
  <main id="main" class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-footer wrap">
    <p>{{ site.title }}, Denmark</p>
    <p><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% for profile in site.profiles %} · <a href="{{ profile.url }}">{{ profile.name }}</a>{% endfor %} · <a href="/feed.xml">Feed</a></p>
  </footer>
</body>
</html>

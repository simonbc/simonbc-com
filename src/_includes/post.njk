---
layout: base.njk
---
<article class="prose">
  <header class="post-header">
    <p class="eyebrow"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    <h1>{{ title }}</h1>
  </header>
  {{ content | safe }}
  <p class="back"><a href="/#blog">All posts</a></p>
</article>
